# BreatheWise AI - Environment Variables
# Copy to .env.local for local development. Never commit real keys.

# Gemini Developer API (Server-side Edge Function only)
GEMINI_API_KEY=your_gemini_api_key_here

# US EPA AirNow API Key (Optional)
AIRNOW_API_KEY=your_airnow_api_key_here

# Supabase Local or Remote Configuration
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
